maintainer="Noa Himesaka <himesaka@noa.codes>"
pkgname=koreader
# _nightly is the KOReader nightly name, e.g. v2026.07.2-50-g7b0938bd8_2026-09-06, and the
# two URLs are where its reMarkable zips live (nightly server or GitLab CI artifacts).
# All three plus pkgver are rewritten by scripts/bump-velbuild.sh; do not edit by hand.
_nightly=v2026.07.2-130-g92bf75f03_2026-09-06
_aarch64_url="https://gitlab.com/api/v4/projects/koreader%2Fnightly-builds/jobs/16338351589/artifacts/koreader/koreader-remarkable-aarch64-v2026.07.2-130-g92bf75f03_2026-09-06.zip"
_armv7_url="https://gitlab.com/api/v4/projects/koreader%2Fnightly-builds/jobs/16338351588/artifacts/koreader/koreader-remarkable-v2026.07.2-130-g92bf75f03_2026-09-06.zip"
pkgver=2026.07.2_git20260906_p130
pkgrel=0
upstream_author="koreader"
category="apps"
pkgdesc="KOReader nightly build - an ebook reader supporting PDF, DjVu, EPUB, FB2 and many more formats."
url="https://github.com/koreader/koreader"
arch="aarch64 armv7"
license="AGPL-3.0"
depends="appload>=0.4.2"
options="!check"
_basetag="${_nightly%%-*}"
_commit="${_nightly#*-g}"
_commit="${_commit%%_*}"
readmeurl="https://raw.githubusercontent.com/$upstream_author/koreader/$_basetag/README.md"
changelogurl="https://github.com/$upstream_author/koreader/compare/$_basetag...$_commit"

source="
koreader-remarkable-aarch64-$_nightly.zip::$_aarch64_url
koreader-remarkable-$_nightly.zip::$_armv7_url
COPYING-$_basetag::https://raw.githubusercontent.com/$upstream_author/koreader/$_basetag/COPYING
KOReader.oxide
"

unpack() {
	case "$CARCH" in
	aarch64) unzip -o "$srcdir"/koreader-remarkable-aarch64-$_nightly.zip -d "$srcdir" ;;
	armv7) unzip -o "$srcdir"/koreader-remarkable-$_nightly.zip -d "$srcdir" ;;
	esac
}

# vbuild runs "abuild check" as an explicit step, which ignores !check in
# options; an empty check() keeps abuild from warning about missing tests.
check() {
	:
}

package() {
	install -d "$pkgdir"/home/root/xovi/exthome/appload
	install -d "$pkgdir"/home/root/.local/share/applications
	cp -r "$srcdir"/koreader \
		"$pkgdir"/home/root/xovi/exthome/appload
	install -Dm644 "$startdir"/KOReader.oxide \
		"$pkgdir"/home/root/.local/share/applications/KOReader.oxide

	sed -i "s/hasOTAUpdates = yes/hasOTAUpdates = no/" \
		"$pkgdir"/home/root/xovi/exthome/appload/koreader/frontend/device/remarkable/device.lua

	install -Dm644 "$srcdir"/COPYING-$_basetag \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/COPYING
	echo "https://github.com/koreader/koreader/archive/$_commit.tar.gz" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/xovi/exthome/appload/koreader
	fi
}

